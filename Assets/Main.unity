  dialogue:
    NPCName: 
    sentences:
    - "Excuse me, the laundry room is locked \ntoday."
    - /(What should I do?)3
    - "(If I start to complain, I worry she might kick \nme out)"
    - /(I have to try this again)~
    - 'I need to do the washing or my roommates''

      going to kill me.'
    - "Well tough luck, you'll have to do it \nanother day."
    - /(What should I do?)4
    - "(I can't even do something as simple as \nlaundry...)"
    - /(I have to try this again)~
    - "(The laundry room is downstairs, and so is \nthe staff room)"
    - /(She may have left a spare key in there)-
    names:
    - Receptionist
    - Me
    - Me
    - Me
    - Me
    - Receptionist
    - Me
    - Me
    - Me
    - Me
    - Me
  nextSentenceButton: {fileID: 1262784875}
