  m_Name: 
  m_EditorClassIdentifier: 
  dialogue:
    NPCName: 
    sentences:
    - 'Hey! '
    - Did you go into the staff room?
    - /(What should I say?)6
    - "(I can't bring myself to lie,     \nwhat if she found out?)"
    - ~(Think, think, let me try again)
    - "Yeah, I really needed to do my laundry, \nsorry."
    - Well you're not supposed to go in there.
    - I could have you evicted for this.
    - /(What should I say?)7
    - (Why am i even thinking of saying that?)
    - '~(I can''t be bothered with conflict,

      I need to end it quickly this
      time)'
    - Look I'm really sorry, I won't do it again.
    - "alright, I'll let this go if you deliver this \nletter."
    - It's for the guy in the unit next to yours.
    - Okay, sure.
    - (Let me do the bins before I forget)
    names:
    - Receptionist
    - Receptionist
    - Me
    - Me
    - Me
    - Me
    - Receptionist
    - Receptionist
    - Me
    - Me
    - Me
    - Me
    - Receptionist
    - Receptionist
    - Me
    - Me
  nextSentenceButton: {fileID: 1262784875}
